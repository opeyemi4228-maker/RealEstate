# ─────────────────────────────────────────────────────────────
#  GCSA Consulting — Environment variable TEMPLATE
#  Copy this file to ".env" and fill in real values.
#  The real ".env" is git-ignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# ── Public (exposed to the browser — never put secrets here) ──
NEXT_PUBLIC_CURRENCY='₦'
# Dev: http://localhost:3000   Prod: https://www.gcsaconsulting.co.uk
NEXT_PUBLIC_SITE_URL='http://localhost:3000'

# ── Database (Prisma Postgres / any PostgreSQL) ──
DATABASE_URL='postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require'

# ── Stripe (programme registration payments — optional) ──
STRIPE_SECRET_KEY=''
STRIPE_WEBHOOK_SECRET=''

# ── Resend (transactional email) ──
RESEND_API_KEY=''
EMAIL_FROM='GCSA Consulting <onboarding@resend.dev>'
EMAIL_TO='info@gcsaconsulting.co.uk'

# ── Admin portal (/admin) ──
ADMIN_EMAIL='admin@gcsaconsulting.co.uk'
ADMIN_PASSWORD='set-a-strong-password'
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=''
